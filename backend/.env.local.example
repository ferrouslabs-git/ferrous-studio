# Local development config. Copy to backend/.env.local (gitignored) and fill in.
#
# Postgres is local (infra/local/docker-compose.yml); Cognito is NOT — there is
# no local Cognito emulator, so local dev authenticates against the real
# STAGING user pool. Run terraform apply in infra/terraform once first (creates
# both pools + both databases), then infra/scripts/create-local-dev-user.ps1
# to get one login to start with.
APP_ENV=local
APP_NAME=webapp-api

# infra/local/docker-compose.yml default credentials/port.
DATABASE_URL=postgresql+psycopg://app:local_dev_pw@localhost:5442/app_local

APP_PUBLIC_URL=http://localhost:8080

# app/auth/ config — values printed by 'terraform output cognito' for the STAGING pool.
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
AUTH_MODE=hosted_ui
# Keep in sync with the include_router(auth_router, prefix="/um") mount in
# app/main.py. Also widens the refresh/CSRF cookie Path to cover both
# /api/um/token/* and /api/um/cookie/* (see app/auth/config.py's
# resolved_auth_cookie_path) — narrower values can leave the cookie unsent on
# some of the module's own endpoints.
AUTH_API_PREFIX=/api/um
AUTH_COOKIE_PATH=/api/um
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
