# Local development config. Copy to backend/.env.local (gitignored) and fill in.
#
# Postgres is local (infra/local/docker-compose.yml); Cognito is NOT — there is
# no local Cognito emulator, so local dev authenticates against the real
# STAGING user pool. Run terraform apply in infra/terraform once first (creates
# both pools + both databases), then infra/scripts/create-local-dev-user.ps1
# to get one login to start with.
APP_ENV=local
APP_NAME=webapp-api

# infra/local/docker-compose.yml default credentials/port.
DATABASE_URL=postgresql+psycopg://app:local_dev_pw@localhost:5442/app_local

APP_PUBLIC_URL=http://localhost:8080

# app/auth/ config — values printed by 'terraform output cognito' for the STAGING pool.
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
AUTH_MODE=hosted_ui
# Comma-separated addresses granted platform admin at their next sign-in.
# The supported way to give an environment its admins -- deployed environments
# set this from app.config.json's platform_admin_emails, since the private RDS
# is unreachable from a laptop. Leave empty to use bootstrap_admin.py instead.
PLATFORM_ADMIN_EMAILS=
# Inviting users (and the set-password page they land on) calls Cognito admin
# APIs on the staging pool: run the backend with AWS credentials that allow
# cognito-idp:AdminCreateUser/AdminGetUser/AdminSetUserPassword/AdminInitiateAuth
# on it (the same profile you use for terraform/deploy is fine).
# Keep in sync with the include_router(auth_router, prefix="/um") mount in
# app/main.py. Also widens the refresh/CSRF cookie Path to cover both
# /api/um/token/* and /api/um/cookie/* (see app/auth/config.py's
# resolved_auth_cookie_path) — narrower values can leave the cookie unsent on
# some of the module's own endpoints.
AUTH_API_PREFIX=/api/um
AUTH_COOKIE_PATH=/api/um
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false

# Invitation emails (optional locally). SES_SENDER_EMAIL must be a verified SES identity in SES_REGION.
SES_REGION=
SES_SENDER_EMAIL=
# Optional: From display name / legal footer on emails (deploys take these from app.config.json).
# PRODUCT_DISPLAY_NAME=Ferrous Studio
# EMAIL_LEGAL=

# Project documents live in S3 (infra/terraform/s3.tf). Local dev uses the real
# STAGING bucket, so the AWS profile the backend runs under needs s3:PutObject/
# GetObject/DeleteObject on it (the terraform/deploy profile is fine). Leave
# empty to disable the Documents section.
DOCUMENTS_BUCKET=ferrous-studio-documents-staging
# DOCUMENTS_MAX_BYTES=26214400
# PRESIGN_TTL_SECONDS=900

# Linking a project to its GitHub repository. This is a GitHub *App*, not an
# OAuth App: create one at https://github.com/settings/apps/new with
#   - Repository permissions: Contents (read & write), Metadata (read-only),
#     Pull requests (read & write) -- write is not used by anything in this
#     backend yet; it is requested now so the agent that pushes branches
#     (go-live-and-merge-boards.md phase 5) needs no re-consent round, since
#     changing an App's permissions later makes every installation re-approve
#   - "Request user authorization (OAuth) during installation": ON
#     (required -- the callback uses it to prove the person finishing the
#     install really has the installation, see app/studio/github.py)
#   - Setup URL: <the origin the app is served from>/api/studio/github/callback
#     This MUST be the same origin the SPA runs on, not merely a URL that
#     reaches the backend. Starting an install sets an HttpOnly cookie that
#     binds the flow to that browser (see start_connect in app/studio/github.py),
#     and a cookie set on one origin is not sent to another -- so a Setup URL on
#     a different port fails every install with "GitHub could not complete the
#     connection". Running the built SPA off the backend: http://localhost:8080.
#     Running the Vite dev server (port 5173, which proxies /api through to
#     8080): http://localhost:5173/api/studio/github/callback.
#   - Webhooks: not needed, leave inactive
# Then generate a private key and paste it below. Leave GITHUB_APP_ID empty to
# disable the Repository section entirely.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The .pem GitHub gives you. A .env file cannot hold real newlines, so either
# base64 the whole file (base64 -w0 key.pem) or replace newlines with \n --
# both are accepted (see _pem in app/config.py).
GITHUB_APP_PRIVATE_KEY=
# GITHUB_API_BASE=https://api.github.com   # only for GitHub Enterprise Server
